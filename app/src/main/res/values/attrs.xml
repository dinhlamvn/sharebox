<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="ShareBoxLinkPreviewView">
        <attr name="thumbnail_height" format="dimension" />
    </declare-styleable>

    <declare-styleable name="ShareBoxUserPointView">
        <attr name="point_icon" format="reference" />
        <attr name="point_name" format="reference" />
    </declare-styleable>

    <declare-styleable name="ShareBoxReadMoreTextView">
        <attr name="collapsed_line" format="integer" />
        <attr name="collapsed_text" format="string" />
        <attr name="expanded_text" format="string" />
        <attr name="read_more_text_color" format="color" />
    </declare-styleable>

    <declare-styleable name="CardViewIconView">
        <attr name="icon_size" format="dimension" />
        <attr name="icon_code" format="string" />
        <attr name="icon_color" format="color" />
    </declare-styleable>

    <declare-styleable name="FontAwesomeIconView">
        <attr name="icon_code" />
        <attr name="icon_size" />
        <attr name="icon_color" />
        <attr name="icon_style" format="enum">
            <enum name="solid" value="0" />
            <enum name="regular" value="1" />
            <enum name="regular_brands" value="2" />
        </attr>
    </declare-styleable>
</resources>